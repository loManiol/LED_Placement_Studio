/* LED Placement Studio – polished dark theme */

QMainWindow, QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
}

/* ---- Typography ---- */
QLabel#pageTitle {
    font-size: 26px;
    font-weight: 700;
    color: #cdd6f4;
    letter-spacing: 0.5px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: #6c7086;
}

QLabel#sectionLabel {
    font-size: 12px;
    font-weight: 700;
    color: #89b4fa;
    letter-spacing: 0.8px;
}

QLabel#hintLabel {
    font-size: 12px;
    color: #a6adc8;
}

QLabel#metricBig {
    font-size: 22px;
    font-weight: 700;
    color: #cdd6f4;
}

QLabel#metricCap {
    font-size: 10px;
    color: #6c7086;
    letter-spacing: 0.5px;
}

/* ---- Cards ---- */
QFrame#card {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
}

QFrame#metricCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
    padding: 6px 12px;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 7px 10px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;
    min-height: 18px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    border: 1px solid #45475a;
    selection-background-color: #89b4fa;
    color: #cdd6f4;
    outline: none;
}

QPlainTextEdit {
    padding: 10px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #45475a;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: #cdd6f4;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #585b70;
}

QPushButton:pressed {
    background-color: #313244;
}

QPushButton:disabled {
    background-color: #313244;
    color: #6c7086;
}

QPushButton#generateBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-size: 15px;
    font-weight: 700;
    border-radius: 10px;
}

QPushButton#generateBtn:hover {
    background-color: #b4befe;
}

QPushButton#generateBtn:disabled {
    background-color: #45475a;
    color: #6c7086;
}

QPushButton#exportBtn {
    background-color: #a6e3a1;
    color: #1e1e2e;
}

QPushButton#exportBtn:hover {
    background-color: #94e2d5;
}

QPushButton#simulateBtn {
    background-color: #f38ba8;
    color: #1e1e2e;
}

QPushButton#simulateBtn:hover {
    background-color: #eba0ac;
}

QPushButton#simulateBtn:disabled {
    background-color: #45475a;
    color: #6c7086;
}

QPushButton#stopBtn {
    background-color: #fab387;
    color: #1e1e2e;
}

QPushButton#stopBtn:hover {
    background-color: #f9e2af;
}

QPushButton#stopBtn:disabled {
    background-color: #45475a;
    color: #6c7086;
}

QPushButton#ghostBtn {
    background-color: transparent;
    border: 1px solid #45475a;
    color: #bac2de;
}

QPushButton#ghostBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
    color: #cdd6f4;
}

/* ---- Checks / radios ---- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #cdd6f4;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #45475a;
    background: #313244;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #89b4fa;
    border-color: #89b4fa;
}

/* ---- Status / canvas ---- */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
}

QGraphicsView {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 10px;
}

QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px 8px;
    border-radius: 4px;
}

QStackedWidget {
    background-color: #1e1e2e;
}
